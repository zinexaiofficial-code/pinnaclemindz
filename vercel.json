{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "^/(sitemap\\.xml|robots\\.txt)",
      "dest": "/$1"
    },
    {
      "src": "^/gantt-chart/(.*)",
      "dest": "/gantt-chart/$1"
    },
    {
      "src": "^/gantt-chart/?$",
      "dest": "/gantt-chart/index.html"
    },
    {
      "src": "^/(.*)",
      "dest": "/index.html"
    }
  ]
}
